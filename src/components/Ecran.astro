---
// LES ÉCRANS DE DROPLET DROP, DESSINÉS EN HTML.
//
// Pas des captures : du texte vrai, traduit dans la langue de la page, net
// à toutes les tailles. Ils reprennent l'application à l'identique — la
// nuit de la couche « scène » (Droplet Design), les cartes #141B28, le dégradé liquide des actions, les
// avatars d'appareils — pour que ce qu'on voit ici soit ce qu'on aura.
//
//   accueil  : l'écran d'accueil, avec les appareils à proximité
//   offre    : la feuille « Léa veut vous envoyer »
//   arrivee  : l'anneau de progression, puis « Tout est arrivé, vérifié. »
import type { Textes } from '../i18n/fr';
import { BASE } from '../i18n';

interface Props {
  t: Textes;
  vue: 'accueil' | 'offre' | 'arrivee';
  /** L'écran large d'un ordinateur, ou celui d'un téléphone. */
  large?: boolean;
  /** Joue l'animation (l'arrivée qui se remplit). */
  anime?: boolean;
}
const { t, vue, large = false, anime = false } = Astro.props;

const appareils = [
  { nom: t.ecPortable, plateforme: 'Mac', code: '4F2A', icone: 'portable', teinte: '#168bff' },
  { nom: t.ecTel, plateforme: 'Android', code: 'B7E0', icone: 'telephone', teinte: '#4855e8' },
  { nom: t.ecBureau, plateforme: 'Windows', code: '19D3', icone: 'bureau', teinte: '#12b8e0' },
];
const ICONES: Record<string, string> = {
  portable: '<rect x="5" y="6" width="14" height="9.5" rx="1.6"/><path d="M3 18.2h18"/>',
  telephone: '<rect x="7.5" y="3.5" width="9" height="17" rx="2.2"/><path d="M11 17.6h2"/>',
  bureau: '<rect x="3.5" y="4.5" width="17" height="11.5" rx="1.8"/><path d="M9 20h6M12 16v4"/>',
};
// Les vignettes des photos envoyées : des dégradés, pas des photos.
const vignettes = ['#ffb36b,#ff5d8f', '#53d1ff,#2b6bff', '#8de08a,#1c9e6a', '#ffd86b,#ff8a3d', '#b58cff,#5b5bf0', '#5ce1e6,#2b8cff'];
---
<div class:list={['ecran', `ecran--${vue}`, { 'ecran--large': large, 'ecran--anime': anime }]}>
  {vue === 'accueil' && (
    <div class="accueil">
      <div class="accueil__tete">
        <img src={`${BASE}/icone-128.webp`} width="44" height="44" alt="" />
        <div>
          <p class="accueil__nom">Droplet Drop</p>
          <p class="accueil__slogan">{t.slogan}</p>
        </div>
      </div>
      <div class="actions">
        <span class="b-liquide">
          <svg viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6" /></svg>{t.ecEnvoyer}
        </span>
        <span class="b-second">
          <svg viewBox="0 0 24 24"><path d="M12 5v14M6 13l6 6 6-6" /></svg>{t.ecRecevoir}
        </span>
      </div>
      <p class="titre-section-app">{t.ecAProximite} <span>3</span></p>
      <ul class="appareils">
        {appareils.map((a) => (
          <li class="carte-app">
            <span class="avatar" style={`--teinte: ${a.teinte}`}>
              <svg viewBox="0 0 24 24" set:html={ICONES[a.icone]} />
            </span>
            <span class="appareil__texte">
              <span class="appareil__nom">{a.nom}</span>
              <span class="appareil__sous"><i></i>{a.plateforme} · {a.code}</span>
            </span>
            <svg class="chevron" viewBox="0 0 24 24"><path d="M9.5 6l6 6-6 6" /></svg>
          </li>
        ))}
      </ul>
    </div>
  )}

  {vue === 'offre' && (
    <div class="offre">
      <div class="offre__fond">
        <div class="accueil__tete accueil__tete--pale">
          <img src={`${BASE}/icone-128.webp`} width="36" height="36" alt="" />
          <p class="accueil__nom">Droplet Drop</p>
        </div>
        <span class="b-liquide b-liquide--pale"></span>
        <span class="b-second b-second--pale"></span>
      </div>
      <div class="feuille">
        <span class="feuille__poignee"></span>
        <span class="avatar avatar--grand" style="--teinte: #168bff">
          <svg viewBox="0 0 24 24" set:html={ICONES.portable} />
        </span>
        <p class="feuille__titre">{t.ecOffreTitre}</p>
        <p class="feuille__quoi">{t.ecOffreQuoi}</p>
        <div class="vignettes">
          {vignettes.slice(0, 4).map((v, i) => (
            <span style={`background: linear-gradient(135deg, ${v})`}>{i === 3 && <b>+20</b>}</span>
          ))}
        </div>
        <p class="feuille__code">{t.ecCode}</p>
        <div class="feuille__boutons">
          <span class="b-second b-petit">{t.ecRefuser}</span>
          <span class="b-liquide b-petit">{t.ecAccepter}</span>
        </div>
      </div>
    </div>
  )}

  {vue === 'arrivee' && (
    <div class="arrivee">
      <div class="anneau">
        <svg viewBox="0 0 120 120">
          <defs>
            <linearGradient id="liquide-anneau" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#168bff" />
              <stop offset="1" stop-color="#34d8ff" />
            </linearGradient>
          </defs>
          <circle class="anneau__fond" cx="60" cy="60" r="52" />
          <circle class="anneau__plein" cx="60" cy="60" r="52" />
        </svg>
        <span class="anneau__pourcent"><span class="compteur"></span></span>
        <svg class="anneau__coche" viewBox="0 0 24 24"><path d="M6 12.5l4 4 8-9" /></svg>
      </div>
      <p class="arrivee__titre">{t.ecVacances}</p>
      <p class="arrivee__etat">
        <span class="arrivee__encours">{t.ecRestant}</span>
        <span class="arrivee__fini">{t.ecVerifie}</span>
      </p>
      <div class="vignettes vignettes--grille">
        {vignettes.map((v) => <span style={`background: linear-gradient(135deg, ${v})`}></span>)}
      </div>
    </div>
  )}
</div>

<style>
  .ecran {
    --fond: var(--dd-scene-nuit);
    --surface: #141b28;
    --surface-2: #202a39;
    --texte: #f7f9fc;
    --texte-2: #a5b0c1;
    --texte-3: #6e7a8e;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background:
      radial-gradient(120% 60% at 0% 0%, rgba(22, 139, 255, 0.16), transparent 60%),
      radial-gradient(90% 50% at 100% 100%, rgba(72, 85, 232, 0.14), transparent 60%),
      var(--fond);
    color: var(--texte);
    font-family: var(--f-texte);
    /* Toutes les tailles suivent la largeur de l'écran : l'écran garde ses
       proportions, qu'il fasse 220 ou 360 pixels de large. */
    font-size: calc(var(--l, 300px) * 0.047);
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-align: start;
  }
  .ecran--large {
    font-size: calc(var(--l, 600px) * 0.0175);
  }
  .ecran svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ── L'accueil ─────────────────────────────────────────────────── */
  .accueil {
    padding: 4.2em 1.4em 1.4em;
  }
  .ecran--large .accueil {
    width: 54%;
    margin-inline: auto;
    padding-top: 2.6em;
  }
  .accueil__tete {
    display: flex;
    align-items: center;
    gap: 0.9em;
  }
  .accueil__tete img {
    width: 2.75em;
    height: 2.75em;
    border-radius: 0.66em;
  }
  .accueil__nom {
    font-family: var(--f-titre);
    font-size: 1.62em;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .accueil__slogan {
    color: var(--texte-2);
    font-size: 0.95em;
  }
  .actions {
    display: grid;
    gap: 0.75em;
    margin-top: 1.75em;
  }
  .b-liquide,
  .b-second {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    height: 4em;
    border-radius: 1.25em;
    font-weight: 650;
    font-size: 1.02em;
  }
  .b-liquide {
    background: linear-gradient(135deg, #168bff, #34d8ff);
    color: #fff;
    box-shadow: 0 0.6em 1.6em -0.8em rgba(22, 139, 255, 0.9);
  }
  .b-second {
    height: 3.75em;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
    color: #4da8ff;
  }
  .b-liquide svg,
  .b-second svg {
    width: 1.3em;
    height: 1.3em;
    stroke-width: 2.4;
  }
  .titre-section-app {
    display: flex;
    justify-content: space-between;
    margin: 2em 0.2em 0.8em;
    font-family: var(--f-titre);
    font-size: 1.12em;
    font-weight: 650;
  }
  .titre-section-app span {
    color: var(--texte-3);
    font-size: 0.8em;
    font-weight: 500;
  }
  .appareils {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.62em;
  }
  .carte-app {
    display: flex;
    align-items: center;
    gap: 0.9em;
    padding: 0.85em 1em;
    border-radius: 1.25em;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.6em;
    height: 2.6em;
    border-radius: 50%;
    background: color-mix(in srgb, var(--teinte) 22%, #141b28);
    color: color-mix(in srgb, var(--teinte) 55%, #fff);
  }
  .avatar svg {
    width: 1.35em;
    height: 1.35em;
    stroke-width: 1.7;
  }
  .avatar--grand {
    width: 3.6em;
    height: 3.6em;
    margin: 0.5em auto 0;
  }
  .avatar--grand svg {
    width: 1.8em;
    height: 1.8em;
  }
  .appareil__texte {
    display: grid;
    min-width: 0;
    flex: 1;
  }
  .appareil__nom {
    font-weight: 600;
    font-size: 1em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .appareil__sous {
    display: flex;
    align-items: center;
    gap: 0.4em;
    color: var(--texte-2);
    font-size: 0.82em;
  }
  .appareil__sous i {
    width: 0.45em;
    height: 0.45em;
    border-radius: 50%;
    background: #34d27b;
  }
  .chevron {
    width: 1.2em;
    height: 1.2em;
    color: var(--texte-3);
  }

  /* ── L'offre ───────────────────────────────────────────────────── */
  .offre__fond {
    padding: 4.2em 1.4em;
    opacity: 0.35;
    filter: blur(1px);
  }
  .offre__fond .b-liquide,
  .offre__fond .b-second {
    margin-top: 0.8em;
  }
  .offre__fond .b-liquide {
    margin-top: 1.8em;
  }
  .feuille {
    position: absolute;
    inset: auto 0 0;
    padding: 0.6em 1.4em 2em;
    border-radius: 1.8em 1.8em 0 0;
    background: rgba(20, 27, 40, 0.94);
    box-shadow:
      0 -1.2em 3em rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    text-align: center;
  }
  .feuille__poignee {
    display: block;
    width: 2.6em;
    height: 0.3em;
    margin: 0 auto 0.6em;
    border-radius: 1em;
    background: rgba(255, 255, 255, 0.2);
  }
  .feuille__titre {
    margin-top: 0.7em;
    font-family: var(--f-titre);
    font-size: 1.3em;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .feuille__quoi {
    color: var(--texte-2);
    font-size: 0.92em;
  }
  .vignettes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4em;
    margin: 1.1em 0 0.9em;
  }
  .vignettes span {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 0.7em;
  }
  .vignettes b {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    border-radius: inherit;
    background: rgba(8, 12, 22, 0.55);
    font-size: 0.95em;
  }
  .feuille__code {
    color: var(--texte-3);
    font-size: 0.78em;
    font-variant-numeric: tabular-nums;
  }
  .feuille__boutons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6em;
    margin-top: 1em;
  }
  .b-petit {
    height: 3.1em;
    border-radius: 1em;
    font-size: 0.95em;
  }
  .feuille__boutons .b-second {
    color: var(--texte);
  }

  /* ── L'arrivée ─────────────────────────────────────────────────── */
  .arrivee {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 2em 1.4em;
    text-align: center;
  }
  .anneau {
    position: relative;
    width: 9.5em;
    height: 9.5em;
  }
  .anneau svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .anneau__fond {
    stroke: var(--surface-2);
    stroke-width: 8;
  }
  .anneau__plein {
    stroke: url(#liquide-anneau);
    stroke-width: 8;
    stroke-dasharray: 327;
    stroke-dashoffset: 0;
  }
  .anneau__pourcent {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--f-titre);
    font-size: 1.9em;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    opacity: 0;
  }
  .anneau__coche {
    position: absolute;
    inset: 22%;
    width: 56% !important;
    height: 56% !important;
    color: #34d8ff;
    transform: none !important;
    stroke-width: 2.6 !important;
    stroke-dasharray: 24;
    stroke-dashoffset: 0;
  }
  .arrivee__titre {
    margin-top: 1.3em;
    font-family: var(--f-titre);
    font-size: 1.35em;
    font-weight: 700;
  }
  .arrivee__etat {
    display: grid;
    color: var(--texte-2);
    font-size: 0.92em;
  }
  .arrivee__etat > span {
    grid-area: 1 / 1;
  }
  .arrivee__encours {
    opacity: 0;
  }
  .vignettes--grille {
    grid-template-columns: repeat(3, 1fr);
    width: 100%;
    margin-top: 1.6em;
  }

  /* L'animation de l'arrivée : l'anneau se remplit, le pourcentage monte,
     puis la coche se dessine et le texte devient « vérifié ». En boucle,
     7 secondes, réglée sur le vol du fichier dans l'ouverture. */
  @property --p {
    syntax: '<integer>';
    inherits: true;
    initial-value: 100;
  }
  .ecran--anime .anneau__plein {
    animation: remplir 7s var(--ease) infinite;
  }
  .ecran--anime .anneau__pourcent {
    animation: pourcent 7s var(--ease) infinite;
  }
  .ecran--anime .compteur {
    animation: compter 7s linear infinite;
    counter-reset: p var(--p);
  }
  .ecran--anime .compteur::after {
    content: counter(p) '%';
  }
  .ecran--anime .anneau__coche {
    animation: coche 7s var(--ease) infinite;
  }
  .ecran--anime .arrivee__encours {
    animation: encours 7s infinite;
  }
  .ecran--anime .arrivee__fini {
    animation: fini 7s infinite;
  }
  @keyframes remplir {
    0%, 22% { stroke-dashoffset: 327; }
    68%, 100% { stroke-dashoffset: 0; }
  }
  @keyframes compter {
    0%, 22% { --p: 0; }
    68%, 100% { --p: 100; }
  }
  @keyframes pourcent {
    0%, 20% { opacity: 0; }
    24%, 68% { opacity: 1; }
    72%, 100% { opacity: 0; }
  }
  @keyframes coche {
    0%, 70% { stroke-dashoffset: 24; opacity: 0; }
    71% { opacity: 1; }
    80%, 96% { stroke-dashoffset: 0; opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes encours {
    0%, 68% { opacity: 1; }
    72%, 100% { opacity: 0; }
  }
  @keyframes fini {
    0%, 70% { opacity: 0; }
    74%, 96% { opacity: 1; }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ecran--anime * {
      animation: none !important;
    }
  }
</style>
