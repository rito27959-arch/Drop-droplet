---
// LE BOUTON « TÉLÉCHARGER », partout le même.
//
// Écrit pour tout le monde, il mène à la section des plateformes ; le
// script `plateforme.ts` le change en « Télécharger pour Windows » (ou Mac,
// Linux, Android) avec le vrai lien, dès que la page connaît l'appareil.
import { TELECHARGEMENTS } from '../config';
import type { Textes } from '../i18n/fr';

interface Props {
  t: Textes;
  /** « petit » : la pastille de la barre de navigation. */
  variante?: 'grand' | 'petit';
  /** Le texte avant détection (et sans JavaScript). */
  texte?: string;
  /** L'ancre de repli (la section des plateformes). */
  ancre?: string;
}
const { t, variante = 'grand', texte = t.telecharger, ancre = '#telecharger' } = Astro.props;
const libelles =
  variante === 'petit'
    ? { android: t.telecharger, windows: t.telecharger, macos: t.telecharger, linux: t.telecharger, ios: t.bientot }
    : { android: t.dlAndroid, windows: t.dlWindows, macos: t.dlMacos, linux: t.dlLinux, ios: t.dlIos };
---
<a
  class:list={[variante === 'petit' ? 'nav__bouton' : 'bouton']}
  href={ancre}
  data-telecharger
  data-liens={JSON.stringify(TELECHARGEMENTS)}
  data-libelles={JSON.stringify(libelles)}
>
  {variante === 'grand' && (
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7 10.5l5 5 5-5M5 20h14" /></svg>
  )}
  <span data-libelle>{texte}</span>
</a>

<style>
  .nav__bouton {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 12px;
    border-radius: 980px;
    background: var(--liquide);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: filter 0.2s;
  }
  .nav__bouton:hover {
    filter: brightness(1.08);
  }
  /* Pas encore disponible ici (iPhone) : le bouton se fait verre, et mène
     aux plateformes, où c'est expliqué. */
  [data-bientot] {
    background: rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
  }
  :global(.fond-gris) [data-bientot],
  :global(.fond-blanc) [data-bientot],
  :global(.sur-clair) [data-bientot] {
    background: rgba(11, 18, 32, 0.06);
    color: var(--encre);
    box-shadow: inset 0 0 0 1px rgba(11, 18, 32, 0.12);
  }
</style>
