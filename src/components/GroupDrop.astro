      <p>{t.gdHote}</p>
    </div>
    <p class="gd__compteur"><b data-compteur>30</b> {t.gdAppareils}</p>
  </div>

  <ol class="gd__etapes contenu--large">
    {etapes.map((e, i) => (
      <li>
        <span>{i + 1}</span>
        <h3>{e.titre}</h3>
        <p>{e.texte}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .gd {
    padding: clamp(96px, 12vw, 170px) 0 clamp(88px, 11vw, 150px);
    text-align: center;
    overflow: hidden;
    background:
      radial-gradient(50% 40% at 50% 55%, rgba(22, 139, 255, 0.22), transparent 70%),
      radial-gradient(60% 40% at 50% 70%, rgba(72, 85, 232, 0.18), transparent 70%),
      var(--noir);
  }
  .gd__surtitre {
    display: inline-block;
    font-family: var(--f-titre);
    font-size: var(--t-2);
    font-weight: 650;
    background: var(--liquide);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .gd__titre {
    margin: 12px auto 0;
    max-width: 14ch;
    font-size: var(--t-5);
    line-height: 1.05;
    letter-spacing: -0.026em;
  }
  .gd__chapo {
    margin: 22px auto 0;
    max-width: 40rem;
  }

  /* ── La scène ───────────────────────────────────────────────────── */
  .gd__scene {
    position: relative;
    aspect-ratio: 16 / 9;
    margin-top: clamp(40px, 6vw, 72px);
    max-height: 640px;
  }
  .gd__liens {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .gd__liens line {
    stroke: rgba(52, 216, 255, 0.14);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .gd__app {
    position: absolute;
    width: clamp(26px, 3.6vw, 46px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
  }
  .gd__app svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .gd__app .fond {
    fill: #141b28;
    stroke: #202a39;
    stroke-width: 3;
  }
  .gd__app .plein {
    fill: none;
    stroke: #34d8ff;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 95;
    stroke-dashoffset: 0;
  }
  /* Sans JavaScript, la distribution est déjà finie ; avec, elle démarre
     vide et se joue quand on arrive dessus. */
  .gd.est-prete .gd__app .plein {
    stroke-dashoffset: 95;
  }
  .gd.est-lancee .gd__app .plein {
    animation: gd-remplir var(--v) var(--d) var(--ease) forwards;
  }
  /* L'appareil : un petit écran au centre de l'anneau. */
  .gd__app i {
    position: absolute;
    inset: 34% 30%;
    border: 1.5px solid #a5b0c1;
    border-radius: 2px;
  }
  .gd__app--tel i {
    inset: 29% 37%;
    border-radius: 3px;
  }
  @keyframes gd-remplir {
    to { stroke-dashoffset: 0; }
  }
  /* Un appareil qui a tout reçu s'allume. */
  .gd__app.est-fini i {
    border-color: #34d8ff;
    background: rgba(52, 216, 255, 0.25);
    transition: all 0.3s;
  }
  .gd__hote {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: clamp(12px, 1.6vw, 20px);
    border-radius: 22px;
    background: rgba(20, 27, 40, 0.92);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.1),
      0 0 60px rgba(22, 139, 255, 0.35);
  }
  .gd__hote p {
    font-size: clamp(0.62rem, 0.9vw, 0.8rem);
    font-weight: 600;
    color: var(--clair);
  }
  .gd__qr {
    width: clamp(64px, 8vw, 104px);
    height: auto;
    border-radius: 8px;
  }
  .gd__qr path {
    fill: #080c16;
  }
  .gd__compteur {
    position: absolute;
    inset: auto 0 -6px;
    font-size: var(--t-1);
    color: var(--clair-2);
  }
  .gd__compteur b {
    font-family: var(--f-titre);
    font-size: var(--t-3);
    color: var(--clair);
    font-variant-numeric: tabular-nums;
    margin-inline-end: 4px;
  }

  /* ── Les étapes ────────────────────────────────────────────────── */
  .gd__etapes {
    list-style: none;
    padding: 0;
    margin-top: clamp(56px, 7vw, 88px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 48px);
    text-align: start;
  }
  .gd__etapes span {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px rgba(52, 216, 255, 0.6);
    color: #34d8ff;
    font-family: var(--f-titre);
    font-weight: 650;
  }
  .gd__etapes h3 {
    margin-top: 16px;
    font-size: var(--t-2);
    letter-spacing: -0.015em;
  }
  .gd__etapes p {
    margin-top: 6px;
    color: var(--clair-2);
  }
  @media (max-width: 760px) {
    .gd__scene {
      aspect-ratio: 1 / 1;
    }
    .gd__etapes {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Quand la scène arrive à l'écran, la distribution « démarre » : chaque
  // anneau se remplit une fois, et le compteur avance d'un cran à chaque
  // appareil arrivé au bout. Ensuite, tout reste à 30 — comme à la fin
  // d'une vraie distribution.
  const section = document.querySelector<HTMLElement>('[data-gd]');
  const compteur = section?.querySelector<HTMLElement>('[data-compteur]');
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (section && compteur && !reduit) {
    compteur.textContent = '0';
    section.classList.add('est-prete');
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        section.classList.add('est-lancee');
        let n = 0;
        section.querySelectorAll<HTMLElement>('.gd__app').forEach((app) => {
          const s = getComputedStyle(app);
          const fin = (parseFloat(s.getPropertyValue('--d')) + parseFloat(s.getPropertyValue('--v'))) * 1000;
          setTimeout(() => {
            app.classList.add('est-fini');
            compteur.textContent = String(++n);
          }, fin);
        });
      },
      { threshold: 0.35 },
    );
    io.observe(section.querySelector('.gd__scene')!);
  }
</script>
