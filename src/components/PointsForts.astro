---
// LES POINTS FORTS — une mosaïque de cartes, à la manière des pages
// produits d'apple.com : deux grandes qui portent l'essentiel (direct ;
// la reprise), quatre plus petites. Chaque carte a SON dessin, qui montre
// ce que dit le texte : pas d'icône décorative.
import type { Textes } from '../i18n/fr';
interface Props { t: Textes }
const { t } = Astro.props;
const blocs = Array.from({ length: 24 }, (_, i) => i);
---
<section id="points-forts" class="pf fond-gris" aria-labelledby="pf-titre">
  <div class="contenu--large">
    <h2 id="pf-titre" class="titre-section apparait">{t.pfTitre}</h2>

    <div class="pf__grille">
      <!-- 1. Direct : deux appareils, l'arc entre eux, et le nuage barré. -->
      <article class="carte carte--grande carte--nuit">
        <div class="carte__texte">
          <h3>{t.pf1Titre}</h3>
          <p>{t.pf1Texte}</p>
        </div>
        <svg class="dessin dessin--direct" viewBox="0 0 400 190" aria-hidden="true">
          <defs>
            <linearGradient id="pf-liquide" x1="0" x2="1">
              <stop offset="0" stop-color="#168bff" /><stop offset="1" stop-color="#34d8ff" />
            </linearGradient>
          </defs>
          <g class="nuage" transform="translate(200 38)">
            <path d="M-26 10h-4a14 14 0 0 1-1-28 20 20 0 0 1 38-6 15 15 0 0 1 21 13 12 12 0 0 1-3 21z" />
            <path class="nuage__barre" d="M-38 -26L34 18" />
          </g>
          <rect class="app" x="22" y="96" width="96" height="62" rx="9" />
          <path class="app" d="M10 168h120" />
          <rect class="app" x="300" y="78" width="54" height="96" rx="12" />
          <path class="arc" d="M120 120 C 170 70, 240 70, 296 118" />
          <circle class="goutte-vol" r="6"><animateMotion dur="2.4s" repeatCount="indefinite" path="M120 120 C 170 70, 240 70, 296 118" /></circle>
        </svg>
      </article>

      <!-- 2. La reprise : la barre s'arrête, une coupure, puis repart. -->
      <article class="carte carte--grande">
        <div class="carte__texte">
          <h3>{t.pf2Titre}</h3>
          <p>{t.pf2Texte}</p>
        </div>
        <div class="dessin dessin--reprise" aria-hidden="true">
          <div class="reprise__ligne">
            <span class="reprise__plein"></span>
            <span class="reprise__coupure">
              <svg viewBox="0 0 24 24"><path d="M3 9a13 13 0 0 1 18 0M6.5 12.5a8 8 0 0 1 11 0M10 16a3 3 0 0 1 4 0M4 4l16 16" /></svg>
            </span>
            <span class="reprise__suite"></span>
          </div>
          <div class="reprise__legende"><span>62%</span><span>100%</span></div>
        </div>
      </article>

      <!-- 3. Vérifié : des blocs, chacun coché. -->
      <article class="carte">
        <div class="dessin dessin--blocs" aria-hidden="true">
          {blocs.map((i) => <span style={`--i: ${i}`}></span>)}
        </div>
        <div class="carte__texte">
          <h3>{t.pf3Titre}</h3>
          <p>{t.pf3Texte}</p>
        </div>
      </article>

      <!-- 4. L'accord : deux boutons. -->
      <article class="carte">
        <div class="dessin dessin--accord" aria-hidden="true">
          <span class="accord__non">{t.ecRefuser}</span>
          <span class="accord__oui">{t.ecAccepter}</span>
        </div>
        <div class="carte__texte">
          <h3>{t.pf4Titre}</h3>
          <p>{t.pf4Texte}</p>
        </div>
      </article>

      <!-- 5. Les dossiers : une arborescence. -->
      <article class="carte">
        <svg class="dessin dessin--dossier" viewBox="0 0 220 96" aria-hidden="true">
          <path class="dossier" d="M14 20a6 6 0 0 1 6-6h22l8 8h40a6 6 0 0 1 6 6v34a6 6 0 0 1-6 6H20a6 6 0 0 1-6-6z" />
          <path class="trait" d="M104 42h20M124 22v60M124 22h14M124 52h14M124 82h14" />
          <rect class="fichier" x="142" y="12" width="64" height="20" rx="6" />
          <rect class="fichier" x="142" y="42" width="52" height="20" rx="6" />
          <rect class="fichier" x="142" y="72" width="70" height="20" rx="6" />
        </svg>
        <div class="carte__texte">
          <h3>{t.pf5Titre}</h3>
          <p>{t.pf5Texte}</p>
        </div>
      </article>

      <!-- 6. Les plateformes. -->
      <article class="carte">
        <div class="dessin dessin--plateformes" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="7.5" y="3.5" width="9" height="17" rx="2.2" /><path d="M11 17.6h2" /></svg>
          <svg viewBox="0 0 24 24"><rect x="5" y="6" width="14" height="9.5" rx="1.6" /><path d="M3 18.2h18" /></svg>
          <svg viewBox="0 0 24 24"><rect x="3.5" y="4.5" width="17" height="11.5" rx="1.8" /><path d="M9 20h6M12 16v4" /></svg>
          <svg viewBox="0 0 24 24"><rect x="5" y="3.5" width="14" height="17" rx="2.4" /><path d="M11 17.6h2" /></svg>
        </div>
        <div class="carte__texte">
          <h3>{t.pf6Titre}</h3>
          <p>{t.pf6Texte}</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .pf {
    padding: clamp(88px, 11vw, 150px) 0;
  }
  .pf .titre-section {
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .pf__grille {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .carte {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    min-height: 380px;
    padding: clamp(26px, 3vw, 38px);
    border-radius: 28px;
    background: var(--blanc);
    color: var(--encre);
    overflow: hidden;
  }
  .carte--grande {
    grid-column: span 2;
    min-height: 460px;
  }
  .carte--nuit {
    background:
      radial-gradient(90% 70% at 80% 100%, rgba(22, 139, 255, 0.28), transparent 70%),
      var(--noir);
    color: var(--clair);
  }
  .carte h3 {
    font-size: var(--t-3);
    line-height: 1.14;
    letter-spacing: -0.02em;
  }
  .carte p {
    margin-top: 10px;
    color: var(--encre-2);
    max-width: 30rem;
  }
  .carte--nuit p {
    color: var(--clair-2);
  }
  .dessin {
    width: 100%;
  }
  /* Dans les petites cartes, les dessins ont tous la même hauteur : les
     titres s'alignent d'une carte à l'autre. */
  .carte:not(.carte--grande) > .dessin {
    height: 96px;
  }
  .carte:not(.carte--grande) > svg.dessin {
    width: auto;
    max-width: 100%;
    align-self: flex-start;
  }

  /* Direct */
  .dessin--direct {
    max-width: 440px;
    align-self: center;
  }
  .dessin--direct .app {
    fill: none;
    stroke: #a5b0c1;
    stroke-width: 3;
    stroke-linecap: round;
  }
  .dessin--direct .arc {
    fill: none;
    stroke: url(#pf-liquide);
    stroke-width: 3;
    stroke-dasharray: 2 9;
    stroke-linecap: round;
  }
  .goutte-vol {
    fill: #34d8ff;
    filter: drop-shadow(0 0 6px #34d8ff);
  }
  .nuage path {
    fill: none;
    stroke: #6e7a8e;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .nuage .nuage__barre {
    stroke: #ff5d55;
  }

  /* Reprise */
  .dessin--reprise {
    margin-block: auto 10px;
  }
  .reprise__ligne {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
  }
  .reprise__plein,
  .reprise__suite {
    height: 14px;
    border-radius: 99px;
  }
  .reprise__plein {
    flex: 62;
    background: var(--liquide);
  }
  .reprise__suite {
    flex: 38;
    background: linear-gradient(90deg, #34d8ff, #168bff);
    opacity: 0.35;
    background-size: 200% 100%;
    animation: reprendre 3.2s var(--ease) infinite;
  }
  @keyframes reprendre {
    0%, 30% { opacity: 0.2; }
    70%, 100% { opacity: 1; }
  }
  .reprise__coupure {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--gris);
    color: #8a94a8;
  }
  .reprise__coupure svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .reprise__legende {
    display: flex;
    justify-content: space-between;
    margin-top: 12px;
    font-family: var(--f-titre);
    font-size: var(--t-3);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--encre);
  }
  .reprise__legende span:first-child {
    color: var(--goutte);
  }

  /* Blocs vérifiés */
  .dessin--blocs {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 6px;
  }
  .dessin--blocs span {
    aspect-ratio: 1;
    border-radius: 6px;
    background: var(--liquide);
    opacity: 0.25;
    animation: verifier 4s calc(var(--i) * 0.08s) var(--ease) infinite;
  }
  @keyframes verifier {
    0%, 10% { opacity: 0.18; }
    30%, 90% { opacity: 1; }
    100% { opacity: 0.18; }
  }

  /* L'accord */
  .dessin--accord {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .dessin--accord span {
    display: grid;
    place-items: center;
    height: 48px;
    border-radius: 16px;
    font-weight: 600;
  }
  .accord__non {
    background: var(--gris);
  }
  .accord__oui {
    background: var(--liquide);
    color: #fff;
  }

  /* Dossiers */
  .dessin--dossier .dossier {
    fill: color-mix(in srgb, var(--goutte) 16%, #fff);
    stroke: var(--goutte);
    stroke-width: 2.5;
  }
  .dessin--dossier .trait {
    fill: none;
    stroke: #c3cad6;
    stroke-width: 2;
  }
  .dessin--dossier .fichier {
    fill: var(--gris);
  }

  /* Plateformes */
  .dessin--plateformes {
    display: flex;
    gap: 14px;
    color: var(--goutte);
  }
  .dessin--plateformes svg {
    width: 44px;
    height: 44px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  @media (max-width: 1000px) {
    .pf__grille {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .pf__grille {
      grid-template-columns: 1fr;
    }
    .carte--grande {
      grid-column: auto;
      min-height: 0;
    }
    .carte {
      min-height: 0;
    }
  }
</style>
