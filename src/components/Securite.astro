---
// LA SÉCURITÉ — sur le modèle de la section confidentialité de
// dropletmesh.app : une phrase, un dessin qui la prouve, trois points.
//
// Le dessin : deux appareils reliés par un tunnel chiffré, et le même code
// de sécurité affiché des deux côtés — ce que l'utilisateur peut vraiment
// vérifier dans l'application.
import type { Textes } from '../i18n/fr';
import { chemin, type Langue } from '../i18n';
interface Props { t: Textes; langue: Langue }
const { t, langue } = Astro.props;
const points = [
  { titre: t.sec1Titre, texte: t.sec1Texte, icone: '<rect x="6" y="14" width="20" height="14" rx="4"/><path d="M10.5 14v-3.5a5.5 5.5 0 0 1 11 0V14"/>' },
  { titre: t.sec2Titre, texte: t.sec2Texte, icone: '<path d="M16 4l10 4v7c0 6.5-4.3 11-10 13-5.7-2-10-6.5-10-13V8z"/><path d="M11.5 16l3 3 6-6.5"/>' },
  { titre: t.sec3Titre, texte: t.sec3Texte, icone: '<circle cx="16" cy="12" r="5"/><path d="M7 27c1-5 4.6-7.5 9-7.5s8 2.5 9 7.5"/><path d="M5 5l22 22"/>' },
];
---
<section id="securite" class="sec fond-gris" aria-labelledby="sec-titre">
  <div class="contenu">
    <h2 id="sec-titre" class="titre-section sec__titre apparait">{t.secTitre}</h2>
    <p class="chapo sec__chapo">{t.secTexte}</p>

    <div class="tunnel" aria-hidden="true">
      <div class="tunnel__app">
        <svg viewBox="0 0 24 24"><rect x="5" y="6" width="14" height="9.5" rx="1.6" /><path d="M3 18.2h18" /></svg>
        <code>4F2A·91C7</code>
      </div>
      <div class="tunnel__voie">
        <span class="tunnel__trait"></span>
        <span class="tunnel__cadenas">
          <svg viewBox="0 0 32 32"><rect x="7" y="14" width="18" height="13" rx="3.5" /><path d="M11 14v-3a5 5 0 0 1 10 0v3" /></svg>
          TLS 1.3
        </span>
        <span class="tunnel__paquets"><i></i><i></i><i></i></span>
      </div>
      <div class="tunnel__app">
        <svg viewBox="0 0 24 24"><rect x="7.5" y="3.5" width="9" height="17" rx="2.2" /><path d="M11 17.6h2" /></svg>
        <code>4F2A·91C7</code>
      </div>
    </div>

    <ul class="sec__points">
      {points.map((p) => (
        <li>
          <svg viewBox="0 0 32 32" aria-hidden="true" set:html={p.icone} />
          <h3>{p.titre}</h3>
          <p>{p.texte}</p>
        </li>
      ))}
    </ul>
    <p class="sec__plus"><a class="lien-fleche" href={chemin(langue, 'security')}>{t.secPlus}</a></p>
  </div>
</section>

<style>
  .sec {
    padding: clamp(88px, 11vw, 150px) 0;
    text-align: center;
  }
  .sec__titre {
    max-width: 15ch;
    margin-inline: auto;
  }
  .sec__chapo {
    margin: 22px auto 0;
    max-width: 40rem;
  }

  .tunnel {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(12px, 3vw, 28px);
    margin: clamp(48px, 7vw, 80px) auto 0;
    max-width: 760px;
  }
  .tunnel__app {
    display: grid;
    justify-items: center;
    gap: 12px;
    padding: 22px clamp(16px, 3vw, 28px);
    border-radius: 24px;
    background: var(--blanc);
    box-shadow: 0 20px 40px -24px rgba(11, 18, 32, 0.3);
  }
  .tunnel__app svg {
    width: 52px;
    height: 52px;
    fill: none;
    stroke: var(--encre);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .tunnel__app code {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: clamp(0.8rem, 1.6vw, 1rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--lien-clair);
    padding: 4px 10px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--goutte) 10%, #fff);
  }
  .tunnel__voie {
    position: relative;
    display: grid;
    place-items: center;
    height: 70px;
  }
  .tunnel__trait {
    position: absolute;
    inset: 50% 0 auto;
    height: 18px;
    transform: translateY(-50%);
    border-radius: 99px;
    background: var(--liquide);
    opacity: 0.18;
  }
  .tunnel__paquets {
    position: absolute;
    inset: 50% 0 auto;
    height: 8px;
    transform: translateY(-50%);
    overflow: hidden;
  }
  .tunnel__paquets i {
    position: absolute;
    top: 0;
    width: 22px;
    height: 8px;
    border-radius: 4px;
    background: var(--liquide);
    animation: paquet 2.4s linear infinite;
  }
  .tunnel__paquets i:nth-child(2) {
    animation-delay: 0.8s;
  }
  .tunnel__paquets i:nth-child(3) {
    animation-delay: 1.6s;
  }
  @keyframes paquet {
    from { left: -10%; }
    to { left: 105%; }
  }
  :global([dir='rtl']) .tunnel__paquets i {
    animation-name: paquet-rtl;
  }
  @keyframes paquet-rtl {
    from { left: 105%; }
    to { left: -10%; }
  }
  .tunnel__cadenas {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px 8px 10px;
    border-radius: 99px;
    background: var(--noir);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .tunnel__cadenas svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: #34d8ff;
    stroke-width: 2.4;
  }

  .sec__points {
    list-style: none;
    padding: 0;
    margin: clamp(56px, 7vw, 88px) 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 48px);
  }
  .sec__points svg {
    width: 40px;
    height: 40px;
    margin-inline: auto;
    fill: none;
    stroke: var(--goutte);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sec__points h3 {
    margin-top: 14px;
    font-size: var(--t-2);
    letter-spacing: -0.015em;
  }
  .sec__points p {
    margin-top: 6px;
    color: var(--encre-2);
  }
  .sec__plus {
    margin-top: 44px;
  }
  @media (max-width: 760px) {
    .sec__points {
      grid-template-columns: 1fr;
    }
    .tunnel__app {
      padding: 16px 10px;
    }
    .tunnel__app svg {
      width: 38px;
      height: 38px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tunnel__paquets {
      display: none;
    }
  }
</style>
