{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/rejoindre",
      "destination": "/rejoindre/",
      "statusCode": 308
    },
    {
      "source": "/android",
      "destination": "https://github.com/rito27959-arch/droplet/releases/download/drop-latest/DropletDrop-android-arm64.apk",
      "statusCode": 302
    },
    {
      "source": "/windows",
      "destination": "https://github.com/rito27959-arch/droplet/releases/download/drop-latest/DropletDrop-windows-x64.zip",
      "statusCode": 302
    },
    {
      "source": "/mac",
      "destination": "https://github.com/rito27959-arch/droplet/releases/download/drop-latest/DropletDrop-macos.zip",
      "statusCode": 302
    },
    {
      "source": "/linux",
      "destination": "https://github.com/rito27959-arch/droplet/releases/download/drop-latest/DropletDrop-linux-x64.tar.gz",
      "statusCode": 302
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=()"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/rejoindre/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
